<?xml version="1.0" ?>
<NotepadPlus>
    <AutoComplete language="Harbour">
        <Environment ignoreCase="yes" startFunc="(" stopFunc=")" paramSeparator="," terminal=";" additionalWordChar=""/>
        <KeyWord name="Aadd" func="yes">
            <Overload retVal="" descr="Dynamically add an element to an array">
                <Param name="&lt;aTarget&gt;"/>
                <Param name="&lt;expValue&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Abs" func="yes">
            <Overload retVal="" descr="Return the absolute value of a number.">
                <Param name="&lt;nExp&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Achoice" func="yes">
            <Overload retVal="" descr="&lt;bUserBlock&gt;"/>
        </KeyWord>
        <KeyWord name="Aclone" func="yes">
            <Overload retVal="" descr="Duplica arrays aninhados ou muldi-dimensionais">
                <Param name="&lt;aSource&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Acopy" func="yes">
            <Overload retVal="" descr="Copia os elementos de uma array para outra">
                <Param name="&lt;aSource&gt;"/>
                <Param name="&lt;aTarget&gt;"/>
                <Param name="&lt;nStart&gt;"/>
                <Param name="&lt;nCount&gt;"/>
                <Param name="&lt;nTagetPos&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Acos" func="yes">
            <Overload retVal="" descr="Arcus cosine of the argument">
                <Param name="nCosine"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Addascii" func="yes">
            <Overload retVal="" descr="Add an integer value to an ascii value of a string">
                <Param name="&lt;[@]cString&gt;"/>
                <Param name="&lt;nValue&gt;"/>
                <Param name="[&lt;nPosition&gt;]"/>
                <Param name="[&lt;lCarryOver&gt;]"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Addmonth" func="yes">
            <Overload retVal="" descr="add months to a date">
                <Param name="[&lt;dDate&gt;,] &lt;nMonths&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Adel" func="yes">
            <Overload retVal="" descr="Exclui um elemento de um array">
                <Param name="&lt;aTarget&gt;"/>
                <Param name="&lt;nPosition&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Adir" func="yes">
            <Overload retVal="" descr="Preenche varios arrays com informacoes de arquivos e diretorios">
                <Param name="&lt;cFileSpec&gt;"/>
                <Param name="&lt;aFilenames&gt;"/>
                <Param name="&lt;aSizes&gt;"/>
                <Param name="&lt;aDates&gt;"/>
                <Param name="&lt;aTimes&gt;"/>
                <Param name="&lt;aAttributes&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Aeval" func="yes">
            <Overload retVal="" descr="Executa um code block para cada elemento">
                <Param name="&lt;aArray&gt;"/>
                <Param name="&lt;bBlock&gt;"/>
                <Param name="&lt;nStart&gt;"/>
                <Param name="&lt;nCount&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Afields" func="yes">
            <Overload retVal="" descr="Fills referenced arrays with database field information">
                <Param name="&lt;aFieldsnames&gt;"/>
                <Param name="&lt;aTypes&gt;"/>
                <Param name="&lt;aWidths&gt;"/>
                <Param name="&lt;aDecimals&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Afill" func="yes">
            <Overload retVal="" descr="Preenche uma array com um determinado valor">
                <Param name="&lt;aTarget&gt;"/>
                <Param name="&lt;expValue&gt;"/>
                <Param name="&lt;nStart&gt;"/>
                <Param name="&lt;nCounts&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Afteratnum" func="yes">
            <Overload retVal="" descr="Returns string portion after nth occurence of substring">
                <Param name="&lt;cStringToMatch&gt;"/>
                <Param name="&lt;cString&gt;"/>
                <Param name="[&lt;nCounter&gt;]"/>
                <Param name="[&lt;nIgnore&gt;]"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Ains" func="yes">
            <Overload retVal="" descr="Insere um elemento com conateudo NIL em um array">
                <Param name="&lt;aTarget&gt;"/>
                <Param name="&lt;nPosition&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Alenalloc" func="yes">
            <Overload retVal="" descr="Determines for how much array elements memory is pre-allocated.">
                <Param name="&lt;aArray&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Alert" func="yes">
            <Overload retVal="" descr="Display a dialog box with a message">
                <Param name="&lt;cMessage&gt;"/>
                <Param name="&lt;aOptions&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Alias" func="yes">
            <Overload retVal="" descr="Verifica qual e o Alias">
                <Param name="&lt;nWorkarea&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Alltrim" func="yes">
            <Overload retVal="" descr="Remove os espacos em branco a direita e a esquerda de uma cadeia de caracteres">
                <Param name="&lt;cString&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Altd" func="yes">
            <Overload retVal="" descr="Invoke the CA-Clipper debugger ( Library:RTL )">
                <Param name="&lt;nAction&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Ampm" func="yes">
            <Overload retVal="" descr="Converts a time string into am/pm format.">
                <Param name="&lt;cTime&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Ansitohtml" func="yes">
            <Overload retVal="" descr="Inserts HTML character entities into an ANSI text string">
                <Param name="&lt;cAnsiString&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Array" func="yes">
            <Overload retVal="" descr="Cria um array com dados nao inicializados">
                <Param name="&lt;nElements&gt;"/>
                <Param name="&lt;nElements&gt;..."/>
            </Overload>
        </KeyWord>
        <KeyWord name="Asc" func="yes">
            <Overload retVal="" descr="Returns the ASCII value of a character">
                <Param name="&lt;cExp&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Ascan" func="yes">
            <Overload retVal="" descr="Busca em um array ate que o bloco retorne verdadeiro">
                <Param name="&lt;aTargets&gt;"/>
                <Param name="&lt;expSearch&gt;"/>
                <Param name="&lt;nStart&gt;"/>
                <Param name="&lt;nCount&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Asciisum" func="yes">
            <Overload retVal="" descr="calculate the sum of the ASCII values of the characters in a string">
                <Param name="&lt;cString&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Ascpos" func="yes">
            <Overload retVal="" descr="ASCII value of a character at a certain position">
                <Param name="&lt;cString&gt;"/>
                <Param name="[&lt;nPosition&gt;]"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Asin" func="yes">
            <Overload retVal="" descr="Arcus sine of the argument">
                <Param name="nSine"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Asize" func="yes">
            <Overload retVal="" descr="Acresenta ou reduz elementos de um array">
                <Param name="&lt;aTarget&gt;"/>
                <Param name="&lt;nLength&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Asizealloc" func="yes">
            <Overload retVal="" descr="Pre-allocates memory for an array.">
                <Param name="&lt;aArray&gt;"/>
                <Param name="&lt;nCount&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Asort" func="yes">
            <Overload retVal="" descr="Ordena um array">
                <Param name="&lt;aTarget&gt;"/>
                <Param name="&lt;nStart&gt;"/>
                <Param name="&lt;nCount&gt;"/>
                <Param name="&lt;bOrder&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="At" func="yes">
            <Overload retVal="" descr="Retorna a posicao da primeira ocorrencia de um substring.">
                <Param name="&lt;cSearch&gt;"/>
                <Param name="&lt;cTarget&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Atadjust" func="yes">
            <Overload retVal="" descr="Adjusts a sequence within a string to a specified position">
                <Param name="&lt;cStringToMatch&gt;"/>
                <Param name="&lt;cString&gt;"/>
                <Param name="&lt;nAdjustPosition&gt;"/>
                <Param name="[&lt;nCounter&gt;]"/>
                <Param name="[&lt;nIgnore&gt;]"/>
                <Param name="[&lt;nFillChar OR cFillChar&gt;]"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Atail" func="yes">
            <Overload retVal="" descr="Retorna o ultimo elemento de um array">
                <Param name="&lt;aArray&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Atan" func="yes">
            <Overload retVal="" descr="Calculates the arc tangent.">
                <Param name="&lt;nRadians&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Atn2" func="yes">
            <Overload retVal="" descr="Arcus tangent a sine and a cosine argument">
                <Param name="nSine"/>
                <Param name="nCosine"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Atnum" func="yes">
            <Overload retVal="" descr="Returns the start position of the nth occurence of a substring in a string">
                <Param name="&lt;cStringToMatch&gt;"/>
                <Param name="&lt;cString&gt;"/>
                <Param name="[&lt;nCounter&gt;]"/>
                <Param name="[&lt;nIgnore&gt;]"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Atrepl" func="yes">
            <Overload retVal="" descr="Search and replace sequences in a string">
                <Param name="&lt;cStringToMatch&gt;"/>
                <Param name="&lt;cString&gt;"/>
                <Param name="&lt;cReplacement&gt;"/>
                <Param name="[&lt;nCounter&gt;]"/>
                <Param name="[&lt;lMode&gt;]"/>
                <Param name="[&lt;nIgnore&gt;]"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Atskipstrings" func="yes">
            <Overload retVal="" descr="Locates the position of a substring within a character string.">
                <Param name="&lt;cSearch&gt;"/>
                <Param name="&lt;cString&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Attoken" func="yes">
            <Overload retVal="" descr="Position of a token in a string">
                <Param name="&lt;cString&gt;"/>
                <Param name="[&lt;cTokenizer&gt;]"/>
                <Param name="[&lt;nTokenCount&gt;]"/>
                <Param name="[&lt;nSkipWidth&gt;]"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Beforatnum" func="yes">
            <Overload retVal="" descr="Returns string portion before nth occurence of substring">
                <Param name="&lt;cStringToMatch&gt;"/>
                <Param name="&lt;cString&gt;"/>
                <Param name="[&lt;nCounter&gt;]"/>
                <Param name="[&lt;nIgnore&gt;]"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Bin2i" func="yes">
            <Overload retVal="" descr="Converter um inteiro com sinal de 16 bits para um valor numerico">
                <Param name="&lt;cSignedInt&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Bin2l" func="yes">
            <Overload retVal="" descr="Converte um inteiro com sinal de 32 bits para um valor numerico">
                <Param name="&lt;cSignedInt&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Bin2u" func="yes">
            <Overload retVal="" descr="Convert unsigned long encoded bytes into Harbour numeric">
                <Param name="&lt;cInteger&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Bin2w" func="yes">
            <Overload retVal="" descr="Converte um inteiro com sinal de 16 bits para um valor numerico">
                <Param name="&lt;cUnsignedInt&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Bittoc" func="yes">
            <Overload retVal="" descr="F BLANK( &lt;xValue&gt;, [&lt;lSpaces&gt;">
                <Param name="&lt;nInteger&gt;"/>
                <Param name="&lt;cBitPattern&gt;[, &lt;lMode&gt;]"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Blobdirectexpo" func="yes">
            <Overload retVal="" descr="Export the contents of a BLOB pointer to a file ( Library:RTL )">
                <Param name="&lt;nBlobID&gt;"/>
                <Param name="&lt;cTargetFile&gt;"/>
                <Param name="[&lt;nMode&gt;]"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Blobdirectget" func="yes">
            <Overload retVal="" descr="Retrieve data from a BLOB file without referencing a field ( Library:RTL )">
                <Param name="&lt;nBlobID&gt;"/>
                <Param name="[&lt;nStart&gt;]"/>
                <Param name="[&lt;nCount&gt;]"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Blobdirectimp" func="yes">
            <Overload retVal="" descr="Import a file into a BLOB file and return pointer to the data ( Library:RTL )">
                <Param name="&lt;nOldBlobID&gt;"/>
                <Param name="&lt;cSourceFile&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Blobdirectput" func="yes">
            <Overload retVal="" descr="Put data in a BLOB file without referencing a specific field ( Library:RTL )">
                <Param name="&lt;nOldblobID&gt;"/>
                <Param name="&lt;xBlobData&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Blobexport" func="yes">
            <Overload retVal="" descr="Copy the contents of a memo field number to a BLOB file ( Library:RTL )">
                <Param name="&lt;nFieldPos&gt;"/>
                <Param name="&lt;cTargetFile&gt;"/>
                <Param name="[&lt;nMode&gt;]"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Blobget" func="yes">
            <Overload retVal="" descr="Get the contents of a BLOB, identified by memo field number ( Library:RTL )">
                <Param name="&lt;nFieldPos&gt;"/>
                <Param name="[&lt;nStart&gt;]"/>
                <Param name="[&lt;nCount&gt;]"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Blobimport" func="yes">
            <Overload retVal="" descr="Read the contents of a BLOB file into a memo field ( Library:RTL )">
                <Param name="&lt;nFieldPos&gt;"/>
                <Param name="&lt;cSourceFile&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Blobrootdelete" func="yes">
            <Overload retVal="" descr="Deleted the root area of a BLOB file ( Library:RTL )"/>
        </KeyWord>
        <KeyWord name="Blobrootget" func="yes">
            <Overload retVal="" descr="Retrieve the data from the root area of a BLOB file  ( Library:RTL )"/>
        </KeyWord>
        <KeyWord name="Blobrootlock" func="yes">
            <Overload retVal="" descr="Obtain a lock on the root area of a BLOB file ( Library:RTL )"/>
        </KeyWord>
        <KeyWord name="Blobrootput" func="yes">
            <Overload retVal="" descr="Store data in the root area of a BLOB file ( Library:RTL )"/>
        </KeyWord>
        <KeyWord name="Blobrootunloc" func="yes">
            <Overload retVal="" descr="Release the lock on a BLOB file's root area ( Library:RTL )"/>
        </KeyWord>
        <KeyWord name="Bof" func="yes">
            <Overload retVal="" descr="Test for the beginning-of-file condition"/>
        </KeyWord>
        <KeyWord name="Bom" func="yes">
            <Overload retVal="" descr="_B_egin _O_f _M_onth">
                <Param name="[&lt;dDate&gt;]"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Boq" func="yes">
            <Overload retVal="" descr="_B_egin _O_f _Q_uarter">
                <Param name="[&lt;dDate&gt;]"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Boy" func="yes">
            <Overload retVal="" descr="_B_egin _O_f _Y_ear">
                <Param name="[&lt;dDate&gt;]"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Break" func="yes">
            <Overload retVal="" descr="Branch out of a BEGIN SEQUENCE...END construct ( Library:RTL )">
                <Param name="&lt;cExpr&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Browse" func="yes">
            <Overload retVal="" descr="Browse a database file">
                <Param name="&lt;nTop&gt;"/>
                <Param name="&lt;nLeft&gt;"/>
                <Param name="&lt;nBottom&gt;"/>
                <Param name="&lt;nRight&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Cdow" func="yes">
            <Overload retVal="" descr="Converte uma data para uma cadeia de caracteres contendo o dia da semana">
                <Param name="&lt;dExpr&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Ceiling" func="yes">
            <Overload retVal="" descr="Rounds up a number to the next integer">
                <Param name="&lt;nNumber&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Celsius" func="yes">
            <Overload retVal="" descr="Temperature conversion Fahrenheit to Celsius">
                <Param name="nDegreeFahrenheit"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Center" func="yes">
            <Overload retVal="" descr="Returns a string for centered display">
                <Param name="&lt;cString&gt;"/>
                <Param name="[&lt;nLength&gt;]"/>
                <Param name="[&lt;cPadChar&gt;]"/>
                <Param name="[&lt;lBothSides&gt;]"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Charadd" func="yes">
            <Overload retVal="" descr="Adds corresponding ASCII value of two strings">
                <Param name="&lt;[@]cString1&gt;"/>
                <Param name="&lt;cString2&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Charand" func="yes">
            <Overload retVal="" descr="Combine corresponding ASCII value of two strings with bitwise AND">
                <Param name="&lt;[@]cString1&gt;"/>
                <Param name="&lt;cString2&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Chareven" func="yes">
            <Overload retVal="" descr="Returns the characters on the even positions in a string">
                <Param name="&lt;cString&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Charhist" func="yes">
            <Overload retVal="" descr="Generates a character histogram of a string">
                <Param name="[&lt;cString&gt;]"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Charlist" func="yes">
            <Overload retVal="" descr="Generates a list of all characters in a string">
                <Param name="[&lt;cString&gt;]"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Charmirr" func="yes">
            <Overload retVal="" descr="Mirror a string">
                <Param name="&lt;[@]cString&gt;"/>
                <Param name="[&lt;lDontMirrorSpaces&gt;]"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Charmix" func="yes">
            <Overload retVal="" descr="Mix two strings">
                <Param name="&lt;cString1&gt;[, &lt;cString2&gt;]"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Charnolist" func="yes">
            <Overload retVal="" descr="Generates a list of all characters not contained in a string">
                <Param name="[&lt;cString&gt;]"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Charnot" func="yes">
            <Overload retVal="" descr="Process each character in a string with bitwise NOT operation">
                <Param name="&lt;[@]cString&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Charodd" func="yes">
            <Overload retVal="" descr="Returns the characters on the odd positions in a string">
                <Param name="&lt;cString&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Charone" func="yes">
            <Overload retVal="" descr="Reduce multiple occurences of a character to one">
                <Param name="[&lt;cCharactersToReduce&gt;,] &lt;cString&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Charonly" func="yes">
            <Overload retVal="" descr="Intersectional set of two strings based on characters">
                <Param name="&lt;cThisCharactersOnly&gt;"/>
                <Param name="&lt;cString&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Charor" func="yes">
            <Overload retVal="" descr="Combine corresponding ASCII value of two strings with bitwise OR">
                <Param name="&lt;[@]cString1&gt;"/>
                <Param name="&lt;cString2&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Charpack" func="yes">
            <Overload retVal="" descr="Compresses a string.">
                <Param name="&lt;cString&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Charpix" func="yes">
            <Overload retVal="" descr="Gets the number of scan lines per character."/>
        </KeyWord>
        <KeyWord name="Charrela" func="yes">
            <Overload retVal="" descr="Character relation of two strings">
                <Param name="&lt;cStringToMatch1&gt;"/>
                <Param name="&lt;cString1&gt;"/>
                <Param name="&lt;cStringToMatch2&gt;"/>
                <Param name="&lt;cString2&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Charrelrep" func="yes">
            <Overload retVal="" descr="Relation dependant character replacement">
                <Param name="&lt;cStringToMatch1&gt;"/>
                <Param name="&lt;cString1&gt;"/>
                <Param name="&lt;cStringToMatch2&gt;"/>
                <Param name="&lt;[@]cString2&gt;"/>
                <Param name="&lt;cReplacement&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Charrem" func="yes">
            <Overload retVal="" descr="Removes characters from a string">
                <Param name="&lt;cDeleteThisCharacters&gt;"/>
                <Param name="&lt;cString&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Charrepl" func="yes">
            <Overload retVal="" descr="Replacement of characters">
                <Param name="&lt;cSearchString&gt;"/>
                <Param name="&lt;[@]cString&gt;"/>
                <Param name="&lt;cReplaceString&gt;"/>
                <Param name="[&lt;lMode&gt;]"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Charrll" func="yes">
            <Overload retVal="" descr="Process each character in a string with bitwise ROLL LEFT operation">
                <Param name="&lt;[@]cString&gt;"/>
                <Param name="&lt;nBitsToRLL&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Charrlr" func="yes">
            <Overload retVal="" descr="Process each character in a string with bitwise ROLL RIGHT operation">
                <Param name="&lt;[@]cString&gt;"/>
                <Param name="&lt;nBitsToRLR&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Charshl" func="yes">
            <Overload retVal="" descr="Process each character in a string with bitwise SHIFT LEFT operation">
                <Param name="&lt;[@]cString&gt;"/>
                <Param name="&lt;nBitsToSHL&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Charshr" func="yes">
            <Overload retVal="" descr="Process each character in a string with bitwise SHIFT RIGHT operation">
                <Param name="&lt;[@]cString&gt;"/>
                <Param name="&lt;nBitsToSHR&gt;"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Charslist" func="yes">
            <Overload retVal="" descr="Generates a sorted list of all characters in a string">
                <Param name="[&lt;cString&gt;]"/>
            </Overload>
        </KeyWord>
        <KeyWord name="Charsort" func="yes">
